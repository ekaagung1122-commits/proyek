APP_NAME=Proyek
APP_ENV=production
APP_DEBUG=false
APP_KEY=

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Chatbot AI (isi API key asli hanya di .env server/VPS, jangan commit nilai asli)
CHATBOT_AI_ENABLED=true
CHATBOT_AI_API_KEY=
CHATBOT_AI_MODEL=gemini-2.5-flash
CHATBOT_AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
CHATBOT_AI_TIMEOUT=20

# Midtrans (isi nilai asli hanya di .env server/VPS, jangan commit nilai asli)
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false